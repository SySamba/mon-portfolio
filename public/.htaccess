# Désactiver la redirection automatique d'Apache vers les slash finaux
DirectorySlash Off

# Force index.html pour toutes les URLs
DirectoryIndex index.html

# Interdire le listage des répertoires
Options -Indexes

# Autoriser explicitement tous les robots et visiteurs
<IfModule mod_authz_core.c>
  Require all granted
</IfModule>

<IfModule !mod_authz_core.c>
  Order allow,deny
  Allow from all
</IfModule>

# Googlebot et autres robots SEO autorisés
<IfModule mod_setenvif.c>
  SetEnvIfNoCase User-Agent "Googlebot" allowed_seo
  SetEnvIfNoCase User-Agent "Bingbot" allowed_seo
  SetEnvIfNoCase User-Agent "Slurp" allowed_seo
  SetEnvIfNoCase User-Agent "DuckDuckBot" allowed_seo
</IfModule>

# Activer le moteur de réécriture
RewriteEngine On

# Rediriger les URLs avec slash final vers sans slash (301)
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Servir les fichiers .html sans extension
# Ex: /services -> services.html, /blog/ia-afrique -> blog/ia-afrique.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*?)/?$ $1.html [L]

# Servir index.html pour la racine
RewriteRule ^$ index.html [L]
